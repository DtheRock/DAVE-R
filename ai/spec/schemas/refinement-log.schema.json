{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daver.dev/spec/1.0.0/refinement-log.schema.json",
  "title": "DAVE+R Refinement Log",
  "type": "object",
  "required": ["entries"],
  "additionalProperties": false,
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "version", "change", "evidence", "impact"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string", "format": "date" },
          "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "change": { "type": "string" },
          "kind": { "enum": ["threshold-tune", "control-escalation", "exception-retired", "rule-retired", "signal-added", "rollback", "simplification"] },
          "evidence": {
            "allOf": [{ "$ref": "common.schema.json#/$defs/value" }],
            "description": "Gate R-3: every refinement must cite observed evidence. 'It felt noisy' is not a refinement."
          },
          "impact": { "$ref": "common.schema.json#/$defs/value" },
          "retires": { "type": "array", "items": { "type": "string" }, "description": "Exception or control IDs retired by this entry." }
        }
      }
    },

    "complexity_trend": {
      "type": "object",
      "description": "Gate R-5. The framework claims the system should get simpler over time. That is only checkable if you count.",
      "additionalProperties": false,
      "properties": {
        "control_count": { "$ref": "common.schema.json#/$defs/value" },
        "exception_count": { "$ref": "common.schema.json#/$defs/value" },
        "mean_exception_age_days": { "$ref": "common.schema.json#/$defs/value" },
        "expired_unactioned_count": { "$ref": "common.schema.json#/$defs/value" }
      }
    },

    "drift_check": {
      "type": "object",
      "description": "Gate R-6. Re-run evasion analysis on cadence. If the same threshold has been ratcheted more than twice, the control class is losing and should be escalated rather than tuned again.",
      "additionalProperties": false,
      "properties": {
        "last_run": { "type": "string", "format": "date" },
        "threshold_adjustments_count": { "$ref": "common.schema.json#/$defs/value" },
        "escalation_recommended": { "type": "boolean" },
        "new_bypasses_observed": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
